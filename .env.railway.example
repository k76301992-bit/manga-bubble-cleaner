# Required for external vision detection (server-side only)
EXTERNAL_OPENAI_API_KEY=
# Optional aliases supported by the cleaner
EXTERNAL_QWEN_BASE_URL=https://ggg-production-739f.up.railway.app/v1
EXTERNAL_QWEN_MODEL=qwen
# Railway supplies PORT automatically
NODE_ENV=production
# Inference sidecar defaults
TEXT_DETECTOR_ENABLED=true
TEXT_DETECTOR_STRICT=false
INFERENCE_ENABLED=true
INFERENCE_STARTUP_TIMEOUT_SEC=180
# Budget for ONE Big-LaMa crop request. The old 20s default aborted healthy
# crops on constrained CPU (production: 100% of regions failed). 120s is safe.
INFERENCE_TIMEOUT_MS=120000
# Inpaint attempts per region; the retry also covers a sidecar restart gap.
INFERENCE_RETRIES=2
# Global cap on simultaneous inpaint requests across ALL jobs. The sidecar
# serializes them internally; more parallel requests only queue and time out.
INFERENCE_MAX_CONCURRENCY=2
# Native thread pools inside the sidecar (torch/OpenCV/OpenMP). Keep 1 on
# CPU-quota containers; higher values caused thread thrashing and OOM.
INFERENCE_NUM_THREADS=1
# Qwen full-page vision call budget (the call runs ONCE per page and healthy
# pages took up to ~161s in production). 300s default, overridable.
QWEN_REQUEST_TIMEOUT_MS=300000
TEXT_DETECTOR_TIMEOUT_MS=180000
# Optional metadata persistence only; no images are stored
MONGODB_URI=
MONGODB_DB_NAME=manga_bubble_cleaner
# Optional trusted server-to-server authentication
SERVICE_API_KEY=
# Optional Discord bot
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
# Optional Google Drive OAuth for large Discord results
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Expo build-time variable; do not put secrets in EXPO_PUBLIC_*
# EXPO_PUBLIC_API_BASE_URL=https://your-railway-domain.up.railway.app
