# Required for external vision detection (server-side only)
EXTERNAL_OPENAI_API_KEY=
# Optional aliases supported by the cleaner
EXTERNAL_QWEN_BASE_URL=https://ggg-production-739f.up.railway.app/v1
EXTERNAL_QWEN_MODEL=qwen
# Railway supplies PORT automatically
NODE_ENV=production
# Inference sidecar defaults
TEXT_DETECTOR_ENABLED=true
TEXT_DETECTOR_STRICT=true
INFERENCE_ENABLED=true
INFERENCE_STARTUP_TIMEOUT_SEC=180
INFERENCE_TIMEOUT_MS=20000
TEXT_DETECTOR_TIMEOUT_MS=12000
# Optional metadata persistence only; no images are stored
MONGODB_URI=
MONGODB_DB_NAME=manga_bubble_cleaner
# Optional trusted server-to-server authentication
SERVICE_API_KEY=
# Optional Discord bot
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
# Optional Google Drive OAuth for large Discord results
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Expo build-time variable; do not put secrets in EXPO_PUBLIC_*
# EXPO_PUBLIC_API_BASE_URL=https://your-railway-domain.up.railway.app
